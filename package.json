{
  "name": "@l1vide/dsh-session-delete",
  "version": "1.3.0",
  "private": false,
  "type": "module",
  "description": "Delete a DSH session from the session menu: conversation gone, leftover scaffolding files cleaned up, results kept",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/transcript.js",
    "lib/classify.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/en.json",
    "locale/zh.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "session-management",
    "delete"
  ],
  "homepage": "https://github.com/Dubai1210/dsh-session-delete#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dubai1210/dsh-session-delete.git"
  },
  "bugs": {
    "url": "https://github.com/Dubai1210/dsh-session-delete/issues"
  },
  "author": "Dubai1210",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
